+        yielding.starts, holding);
+      const auto from_holding = yielding.planner->quickest_path(
+        {Plan::Start{epoch, holding, 0.0}}, yielding.goal.waypoint());
+      if (to_holding && from_holding)
+      {
+        holding_candidates.emplace_back(
+          to_holding->cost() + from_holding->cost(), holding);
+      }
+    }
+    std::sort(holding_candidates.begin(), holding_candidates.end());
+    result._pimpl->metrics.holding_candidates += holding_candidates.size();
+
+    for (const auto& [_, holding] : holding_candidates)
+    {
+      if (result._pimpl->metrics.low_level_replans
+        >= options.max_low_level_replans)
+      {
+        return finish(Status::budget_exceeded, "low_level_replan_budget");
+      }
+
+      ++result._pimpl->metrics.low_level_replans;
+      Plan::Goal holding_goal{holding};
+      if (std::any_of(
+          yielding.starts.begin(), yielding.starts.end(),
+          [holding](const auto& start)
+          {
+            return start.waypoint() == holding;
+          }))
+      {
+        const auto latest_start = std::max_element(
+          yielding.starts.begin(), yielding.starts.end(),
+          [](const auto& a, const auto& b)
+          {
+            return a.time() < b.time();
+          })->time();
+        holding_goal.minimum_time(latest_start + std::chrono::seconds(1));
+      }
+      auto prefix_result = yielding.planner->plan(
+        yielding.starts,
+        std::move(holding_goal),
+        make_options_for(yielding, {}));
+      if (!prefix_result)
+      {
+        if (prefix_result.interrupted()
+          && std::chrono::steady_clock::now() >= deadline)
+        {
+          return finish(Status::budget_exceeded, "time_budget");
+        }
+        if (prefix_result.interrupted() && externally_interrupted())
+          return finish(Status::interrupted, "low_level_interrupted");
+
+        continue;
+      }
+      ++result._pimpl->metrics.holding_prefix_plans;
+      const Plan prefix = *std::move(prefix_result);
+      const auto prefix_reservation = make_reservation(
+        yielding, profiles.at(yielding.id), prefix);
+
+      std::vector<std::size_t> remaining;
+      for (std::size_t i = 0; i < agents.size(); ++i)
+        if (i != yielding_index)
+          remaining.push_back(i);
+      std::sort(remaining.begin(), remaining.end(), [&](const auto a, const auto b)
+        {
+          return agents[a].id < agents[b].id;
+        });
+
+      do
+      {
+        if (std::chrono::steady_clock::now() >= deadline)
+          return finish(Status::budget_exceeded, "time_budget");
+        if (++result._pimpl->metrics.high_level_nodes
+          > options.max_high_level_nodes)
+        {
+          return finish(Status::budget_exceeded, "high_level_node_budget");
+        }
+
+        Proposal candidate;
+        std::vector<Reservation> reservations{prefix_reservation};
+        std::vector<Reservation> other_reservations;
+        bool failed = false;
+        for (const auto index : remaining)
+        {
+          const auto& agent = agents[index];
+          if (result._pimpl->metrics.low_level_replans
+            >= options.max_low_level_replans)
+          {
+            return finish(
+              Status::budget_exceeded, "low_level_replan_budget");
+          }
+
+          std::optional<Plan> complete_plan;
+          const auto& agent_graph =
+            agent.planner->get_configuration().graph();
+          const auto release_time =
+            prefix_reservation.terminal_time + std::chrono::seconds(1);
+
+          ++result._pimpl->metrics.low_level_replans;
+          auto direct_result = agent.planner->plan(
+            agent.starts, agent.goal,
+            make_options_for(agent, reservations));
+          if (direct_result)
+          {
+            complete_plan = *std::move(direct_result);
+          }
+          else
+          {
+            const auto blockers = direct_result.blockers();
+            result._pimpl->blockers.insert(
