+            Plan wait_plan = *std::move(wait_result);
+            const auto wait_finish = wait_plan.get_itinerary().empty()
+              ? wait_plan.get_start().time()
+              : wait_plan.get_itinerary().back().trajectory().back().time();
+            const auto wait_orientation = wait_plan.get_itinerary().empty()
+              ? wait_plan.get_start().orientation()
+              : wait_plan.get_itinerary().back().trajectory()
+              .back().position()[2];
+            const std::vector<Plan::Start> delayed_starts{Plan::Start{
+                wait_finish,
+                agent.starts.front().waypoint(),
+                wait_orientation}};
+            if (result._pimpl->metrics.low_level_replans
+              >= options.max_low_level_replans)
+            {
+              return finish(
+                Status::budget_exceeded, "low_level_replan_budget");
+            }
+            ++result._pimpl->metrics.low_level_replans;
+            auto delayed_result = agent.planner->plan(
+              delayed_starts, agent.goal,
+              make_options_for(agent, reservations));
+            if (delayed_result)
+            {
+              complete_plan = Plan::concatenate(
+                std::move(wait_plan), *std::move(delayed_result));
+            }
+            else
+            {
+              const auto blockers = delayed_result.blockers();
+              result._pimpl->blockers.insert(
+                blockers.begin(), blockers.end());
+              if (delayed_result.interrupted()
+                && std::chrono::steady_clock::now() >= deadline)
+              {
+                return finish(Status::budget_exceeded, "time_budget");
+              }
+              if (delayed_result.interrupted() && externally_interrupted())
+                return finish(Status::interrupted, "low_level_interrupted");
+            }
+          }
+
+          if (!complete_plan)
+          {
+            failed = true;
+            break;
+          }
+
+          auto inserted = candidate.emplace(
+            agent.id, *std::move(complete_plan));
+          auto reservation = make_reservation(
+            agent, profiles.at(agent.id), inserted.first->second);
+          reservations.push_back(reservation);
+          other_reservations.push_back(std::move(reservation));
+        }
+
+        if (failed)
+          continue;
+
+        Time resume_time = prefix_reservation.terminal_time;
+        for (const auto& reservation : other_reservations)
+        {
+          resume_time = std::max(
+            resume_time,
+            reservation.terminal_time + std::chrono::seconds(1));
+        }
+
+        if (result._pimpl->metrics.low_level_replans
+          >= options.max_low_level_replans)
+        {
+          return finish(Status::budget_exceeded, "low_level_replan_budget");
+        }
+        ++result._pimpl->metrics.low_level_replans;
+        auto suffix_result = yielding.planner->plan(
+          Plan::Start{
+            resume_time,
+            holding,
+            prefix_reservation.terminal_position[2]},
+          yielding.goal,
+          make_options_for(yielding, other_reservations));
+        if (!suffix_result)
+        {
+          if (suffix_result.interrupted()
+            && std::chrono::steady_clock::now() >= deadline)
+          {
+            return finish(Status::budget_exceeded, "time_budget");
+          }
+          if (suffix_result.interrupted() && externally_interrupted())
+            return finish(Status::interrupted, "low_level_interrupted");
+
+          continue;
+        }
+        ++result._pimpl->metrics.holding_suffix_plans;
+
+        candidate.emplace(
+          yielding.id,
+          Plan::concatenate(prefix, *std::move(suffix_result)));
+        std::unordered_map<schedule::ParticipantId, Reservation>
+          candidate_reservations;
+        for (const auto& agent : agents)
