+//==============================================================================
+Plan Plan::concatenate(Plan prefix, Plan suffix)
+{
+  const auto route_offset = static_cast<RouteId>(
+    prefix._pimpl->plan.routes.size());
+  auto& prefix_data = prefix._pimpl->plan;
+  auto& suffix_data = suffix._pimpl->plan;
+
+  RouteId suffix_offset = route_offset;
+  if (!prefix_data.routes.empty() && !suffix_data.routes.empty())
+  {
+    const auto& prefix_route = prefix_data.routes.back();
+    const auto& prefix_terminal = prefix_route.trajectory().back();
+    const auto suffix_start =
+      *suffix_data.routes.front().trajectory().start_time();
+    if (prefix_route.map() == suffix_data.routes.front().map()
+      && prefix_terminal.time() < suffix_start)
+    {
+      Trajectory wait;
+      wait.insert(
+        prefix_terminal.time(),
+        prefix_terminal.position(),
+        Eigen::Vector3d::Zero());
+      wait.insert(
+        suffix_start,
+        prefix_terminal.position(),
+        Eigen::Vector3d::Zero());
+      prefix_data.routes.emplace_back(prefix_route.map(), std::move(wait));
+      ++suffix_offset;
+    }
+  }
+
+  prefix_data.routes.insert(
+    prefix_data.routes.end(),
+    std::make_move_iterator(suffix_data.routes.begin()),
+    std::make_move_iterator(suffix_data.routes.end()));
+  for (auto& waypoint : suffix_data.waypoints)
+  {
+    Waypoint::Implementation::shift_route_ids(waypoint, suffix_offset);
+    prefix_data.waypoints.push_back(std::move(waypoint));
+  }
+
+  prefix_data.cost += suffix_data.cost;
+  return prefix;
+}
