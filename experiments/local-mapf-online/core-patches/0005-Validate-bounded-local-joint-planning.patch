+    std::vector<std::pair<double, std::size_t>> holding_candidates;
+    for (std::size_t holding = 0; holding < graph.num_waypoints(); ++holding)
+    {
+      if (!graph.get_waypoint(holding).is_holding_point()
+        || holding == yielding.goal.waypoint())
+      {
+        continue;
+      }
+
