+#ifndef RMF_TRAFFIC__AGV__LOCALCONFLICTRESOLVER_HPP
+#define RMF_TRAFFIC__AGV__LOCALCONFLICTRESOLVER_HPP
+
+#include <rmf_traffic/agv/Planner.hpp>
+#include <rmf_traffic/schedule/Viewer.hpp>
+
+#include <rmf_utils/impl_ptr.hpp>
+
+#include <chrono>
+#include <unordered_map>
+#include <unordered_set>
+
+namespace rmf_traffic {
+namespace agv {
+
+//==============================================================================
+/// A bounded prioritized joint planner for small local conflict sets.
+///
+/// This solver is not complete MAPF. Callers should fall back to the standard
+/// RMF negotiation when it does not return a proposal.
+class LocalConflictResolver
+{
+public:
+
+  static constexpr std::size_t hard_maximum_agents = 4;
+
+  enum class Status
+  {
+    success,
+    no_conflict,
+    unsupported,
+    infeasible,
+    budget_exceeded,
+    interrupted
+  };
+
+  struct Agent
+  {
+    schedule::ParticipantId id;
+    std::vector<Plan::Start> starts;
+    Plan::Goal goal;
+    std::shared_ptr<const Planner> planner;
+  };
+
+  struct Options
+  {
+    std::size_t max_agents = hard_maximum_agents;
+    std::size_t max_high_level_nodes = 64;
+    std::size_t max_low_level_replans = 96;
+    std::chrono::steady_clock::duration max_solve_time =
+      std::chrono::seconds(2);
+  };
+
+  struct Metrics
+  {
+    Status status = Status::unsupported;
+    std::string termination_reason = "not_started";
+    double solve_seconds = 0.0;
+    std::size_t high_level_nodes = 0;
+    std::size_t low_level_replans = 0;
+    std::size_t conflicts_detected = 0;
+    std::size_t conflicts_resolved = 0;
+    std::size_t holding_points_used = 0;
+    double makespan_seconds = 0.0;
+    double total_arrival_seconds = 0.0;
+    double total_delay_seconds = 0.0;
+  };
+
+  using Proposal = std::unordered_map<schedule::ParticipantId, Plan>;
+
+  class Result
+  {
+  public:
+
+    const std::optional<Proposal>& proposal() const;
+
+    const std::unordered_set<schedule::ParticipantId>& blockers() const;
+
+    const Metrics& metrics() const;
+
+    class Implementation;
+  private:
+    rmf_utils::impl_ptr<Implementation> _pimpl;
+    friend class LocalConflictResolver;
+  };
+
+  explicit LocalConflictResolver(
+    std::shared_ptr<const schedule::Viewer> viewer);
+
+  LocalConflictResolver(
+    std::shared_ptr<const schedule::Viewer> viewer,
+    Options options);
+
+  const Options& options() const;
+
+  LocalConflictResolver& options(Options value);
+
+  Result solve(const std::vector<Agent>& agents) const;
+
+  class Implementation;
+private:
+  rmf_utils::impl_ptr<Implementation> _pimpl;
+};
+
+} // namespace agv
+} // namespace rmf_traffic
+
+#endif // RMF_TRAFFIC__AGV__LOCALCONFLICTRESOLVER_HPP
