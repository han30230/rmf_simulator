+struct Reservation
+{
+  schedule::ParticipantId participant;
+  Profile profile;
+  Plan plan;
+  std::string initial_map;
+  Time initial_time;
+  Eigen::Vector3d initial_position;
+  std::string terminal_map;
+  Time terminal_time;
+  Eigen::Vector3d terminal_position;
+};
+
+Reservation make_reservation(
+  const LocalConflictResolver::Agent& agent,
+  const Profile& profile,
+  Plan plan)
+{
+  const auto& graph = agent.planner->get_configuration().graph();
+  const auto& start = plan.get_start();
+  const auto& start_waypoint = graph.get_waypoint(start.waypoint());
+  const auto location = start.location().value_or(
+    start_waypoint.get_location());
+  const Eigen::Vector3d initial_position{
+    location.x(), location.y(), start.orientation()};
+
+  std::string terminal_map = start_waypoint.get_map_name();
+  Time terminal_time = start.time();
+  Eigen::Vector3d terminal_position = initial_position;
+  if (!plan.get_itinerary().empty())
+  {
+    const auto& terminal_route = plan.get_itinerary().back();
+    const auto& terminal = terminal_route.trajectory().back();
+    terminal_map = terminal_route.map();
+    terminal_time = terminal.time();
+    terminal_position = terminal.position();
+  }
+
+  return Reservation{
+    agent.id,
+    profile,
+    std::move(plan),
+    start_waypoint.get_map_name(),
+    start.time(),
+    initial_position,
+    std::move(terminal_map),
+    terminal_time,
+    terminal_position};
+}
+
+class LocalRouteValidator : public RouteValidator
+{
+public:
+  LocalRouteValidator(
+    std::shared_ptr<const schedule::Viewer> viewer,
+    std::unordered_set<schedule::ParticipantId> local_participants,
+    Profile profile,
+    std::vector<Reservation> reservations)
+  : _viewer(std::move(viewer)),
+    _local_participants(std::move(local_participants)),
+    _profile(std::move(profile)),
+    _reservations(std::move(reservations))
+  {
+    // Do nothing
+  }
+
+  std::optional<Conflict> find_conflict(const Route& route) const final
+  {
+    if (_viewer)
+    {
+      schedule::Query::Spacetime spacetime;
+      spacetime.query_timespan()
+      .all_maps(false)
+      .add_map(route.map())
+      .set_lower_time_bound(*route.trajectory().start_time())
+      .set_upper_time_bound(*route.trajectory().finish_time());
+
+      const auto view = _viewer->query(
+        spacetime, schedule::Query::Participants::make_all());
+      for (const auto& item : view)
+      {
+        if (_local_participants.count(item.participant) > 0)
+          continue;
+
+        const auto conflict = DetectConflict::between(
+          _profile, route.trajectory(),
+          route.check_dependencies(
+            item.participant, item.plan_id, item.route_id),
+          item.description.profile(), item.route->trajectory(), nullptr);
+        if (conflict)
+        {
+          return Conflict{
+            Dependency{
+              item.participant,
+              item.plan_id,
+              item.route_id,
+              item.route->trajectory().index_after(conflict->time)},
+            conflict->time,
+            item.route};
+        }
+      }
+
+      schedule::Query::Spacetime all_time;
+      all_time.query_timespan()
+      .all_maps(false)
+      .add_map(route.map());
+      const auto all_routes = _viewer->query(
+        all_time, schedule::Query::Participants::make_all());
+      std::unordered_map<schedule::ParticipantId,
+        const schedule::Viewer::View::Element*> terminal_routes;
+      for (const auto& item : all_routes)
+      {
+        if (_local_participants.count(item.participant) > 0)
+          continue;
+
+        const auto existing = terminal_routes.find(item.participant);
+        if (existing == terminal_routes.end()
+          || existing->second->route_id < item.route_id)
+        {
+          terminal_routes.insert_or_assign(item.participant, &item);
+        }
+      }
+
+      for (const auto& [participant, item_ptr] : terminal_routes)
+      {
+        const auto& item = *item_ptr;
+        const auto& endpoint = item.route->trajectory().back();
+        if (endpoint.time() >= *route.trajectory().finish_time())
+          continue;
+
+        Trajectory stationary;
+        stationary.insert(
+          endpoint.time(), endpoint.position(), Eigen::Vector3d::Zero());
+        stationary.insert(
+          *route.trajectory().finish_time() + std::chrono::seconds(1),
+          endpoint.position(), Eigen::Vector3d::Zero());
+        const auto conflict = DetectConflict::between(
+          _profile, route.trajectory(), nullptr,
+          item.description.profile(), stationary, nullptr);
+        if (conflict)
+        {
+          return Conflict{
+            Dependency{
+              participant,
+              item.plan_id,
+              item.route_id,
+              item.route->trajectory().size() - 1},
+            conflict->time,
+            std::make_shared<Route>(route.map(), std::move(stationary))};
+        }
+      }
+    }
+
+    for (const auto& reservation : _reservations)
+    {
+      RouteId route_id = 0;
+      for (const auto& other : reservation.plan.get_itinerary())
+      {
+        if (route.map() == other.map())
+        {
+          const auto conflict = DetectConflict::between(
+            _profile, route.trajectory(), nullptr,
+            reservation.profile, other.trajectory(), nullptr);
+          if (conflict)
+          {
+            return Conflict{
+              Dependency{
+                reservation.participant, 0, route_id,
+                other.trajectory().index_after(conflict->time)},
+              conflict->time,
+              std::make_shared<Route>(other)};
+          }
+        }
+
+        ++route_id;
+      }
+
+      const auto& itinerary = reservation.plan.get_itinerary();
+      if (reservation.terminal_map != route.map())
+        continue;
+
+      if (reservation.terminal_time >= *route.trajectory().finish_time())
+        continue;
+
+      Trajectory stationary;
+      stationary.insert(
+        reservation.terminal_time,
+        reservation.terminal_position,
+        Eigen::Vector3d::Zero());
+      stationary.insert(
+        *route.trajectory().finish_time() + std::chrono::seconds(1),
+        reservation.terminal_position,
+        Eigen::Vector3d::Zero());
+      const auto conflict = DetectConflict::between(
+        _profile, route.trajectory(), nullptr,
+        reservation.profile, stationary, nullptr);
+      if (conflict)
+      {
+        return Conflict{
+          Dependency{reservation.participant, 0,
+            itinerary.empty()
+            ? 0 : static_cast<RouteId>(itinerary.size() - 1), 0},
+          conflict->time,
+          std::make_shared<Route>(route.map(), std::move(stationary))};
+      }
+    }
+
+    return std::nullopt;
+  }
+
+  std::unique_ptr<RouteValidator> clone() const final
+  {
+    return std::make_unique<LocalRouteValidator>(*this);
+  }
+
+private:
+  std::shared_ptr<const schedule::Viewer> _viewer;
+  std::unordered_set<schedule::ParticipantId> _local_participants;
+  Profile _profile;
+  std::vector<Reservation> _reservations;
+};
+
+bool plans_conflict(const Reservation& a, const Reservation& b)
+{
+  for (const auto& route_a : a.plan.get_itinerary())
+  {
+    for (const auto& route_b : b.plan.get_itinerary())
+    {
+      if (route_a.map() != route_b.map())
+        continue;
+
+      if (DetectConflict::between(
+          a.profile, route_a.trajectory(), nullptr,
+          b.profile, route_b.trajectory(), nullptr))
+      {
+        return true;
+      }
+    }
+  }
+
+  const auto check_terminal = [](
+      const Reservation& stationary_plan,
+      const Reservation& moving_plan)
+    {
+      const auto horizon = moving_plan.terminal_time;
+      if (stationary_plan.terminal_time >= horizon)
+        return false;
+
+      Trajectory stationary;
+      stationary.insert(
+        stationary_plan.terminal_time,
+        stationary_plan.terminal_position,
+        Eigen::Vector3d::Zero());
+      stationary.insert(
+        horizon + std::chrono::seconds(1),
+        stationary_plan.terminal_position,
+        Eigen::Vector3d::Zero());
+      for (const auto& moving_route : moving_plan.plan.get_itinerary())
+      {
+        if (moving_route.map() != stationary_plan.terminal_map)
+          continue;
+
+        if (DetectConflict::between(
+            stationary_plan.profile, stationary, nullptr,
+            moving_plan.profile, moving_route.trajectory(), nullptr))
+        {
+          return true;
+        }
+      }
+
+      return false;
+    };
+
+  return check_terminal(a, b) || check_terminal(b, a);
+}
+
+void populate_metrics(
+  LocalConflictResolver::Metrics& metrics,
+  const LocalConflictResolver::Proposal& proposal,
+  const std::vector<LocalConflictResolver::Agent>& agents,
+  const std::unordered_map<schedule::ParticipantId, double>& ideal_arrivals,
+  const Time epoch)
+{
+  for (const auto& agent : agents)
+  {
+    const auto& plan = proposal.at(agent.id);
+    const auto finish_time = plan.get_itinerary().empty()
+      ? plan.get_start().time()
+      : plan.get_itinerary().back().trajectory().back().time();
+    const double arrival = std::chrono::duration<double>(
+      finish_time - epoch).count();
+    metrics.makespan_seconds = std::max(metrics.makespan_seconds, arrival);
+    metrics.total_arrival_seconds += arrival;
+    metrics.total_delay_seconds += std::max(
+      0.0, arrival - ideal_arrivals.at(agent.id));
+
+    bool used_holding = false;
+    const auto& graph = agent.planner->get_configuration().graph();
+    for (const auto& route : plan.get_itinerary())
+    {
+      if (route.trajectory().size() < 2)
+        continue;
+
+      auto previous = route.trajectory().begin();
+      auto current = previous;
+      ++current;
+      for (; current != route.trajectory().end(); ++current)
+      {
+        const auto stationary_seconds = std::chrono::duration<double>(
+          current->time() - previous->time()).count();
+        if ((current->position().block<2, 1>(0, 0)
+          - previous->position().block<2, 1>(0, 0)).norm() < 1e-3
+          && stationary_seconds >= 1.0)
+        {
+          for (std::size_t i = 0; i < graph.num_waypoints(); ++i)
+          {
+            const auto& waypoint = graph.get_waypoint(i);
+            if (waypoint.is_holding_point()
+              && waypoint.get_map_name() == route.map()
+              && (waypoint.get_location()
+              - current->position().block<2, 1>(0, 0)).norm() < 1e-3)
+            {
+              used_holding = true;
+              break;
+            }
+          }
+        }
+
+        if (used_holding)
+          break;
+
+        previous = current;
+      }
+
+      if (used_holding)
+        break;
+    }
+
+    if (used_holding)
+      ++metrics.holding_points_used;
+  }
+}
