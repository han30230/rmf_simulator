+  auto planner = std::make_shared<rmf_traffic::agv::Planner>(
+    rmf_traffic::agv::Planner::Configuration{graph, traits},
+    rmf_traffic::agv::Planner::Options{nullptr, std::chrono::seconds(1)});
+  return {std::move(database), std::move(planner), profile,
+    std::chrono::steady_clock::now(), west_start, east_start,
+    west_goal, east_goal};
+}
+
+bool plans_conflict(
+  const rmf_traffic::agv::Plan& a,
+  const rmf_traffic::agv::Plan& b,
+  const rmf_traffic::Profile& profile)
+{
+  for (const auto& route_a : a.get_itinerary())
+  {
+    for (const auto& route_b : b.get_itinerary())
+    {
+      if (route_a.map() != route_b.map())
+        continue;
+
+      if (rmf_traffic::DetectConflict::between(
+          profile, route_a.trajectory(), nullptr,
+          profile, route_b.trajectory(), nullptr))
+      {
+        return true;
+      }
+    }
+  }
+
+  return false;
+}
