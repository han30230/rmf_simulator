+#ifndef RMF_FLEET_ADAPTER__LOCAL_TRAFFIC__ROBOTOBSERVATION_HPP
+#define RMF_FLEET_ADAPTER__LOCAL_TRAFFIC__ROBOTOBSERVATION_HPP
+
+#include <rmf_traffic/agv/Planner.hpp>
+
+#include <Eigen/Core>
+
+#include <cstdint>
+#include <optional>
+
+namespace rmf_fleet_adapter {
+namespace local_traffic {
+
+struct QuiescenceOptions
+{
+  rmf_traffic::Duration report_freshness = std::chrono::seconds(1);
+  rmf_traffic::Duration settle_duration = std::chrono::milliseconds(500);
+  rmf_traffic::Duration stop_timeout = std::chrono::seconds(5);
+  double translation_tolerance = 0.01;
+  double rotation_tolerance = 0.02;
+  double speed_threshold = 0.01;
+};
+
+enum class QuiescenceStatus
+{
+  waiting_for_report,
+  waiting_for_post_stop_report,
+  waiting_for_motion_evidence,
+  stale_report,
+  disconnected,
+  invalid_starts,
+  moving,
+  settling,
+  ready,
+  timeout
+};
+
+class RobotObservationTracker
+{
+public:
+  explicit RobotObservationTracker(
+    double translation_tolerance = 0.01,
+    double rotation_tolerance = 0.02);
+
+  struct Report
+  {
+    rmf_traffic::Time received_at;
+    rmf_traffic::Time sample_time;
+    Eigen::Vector3d pose;
+    std::optional<bool> driving;
+    std::optional<double> speed;
+    bool connected;
+    rmf_traffic::agv::Plan::StartSet starts;
+  };
+
+  void update(Report report);
+
+  void request_stop(rmf_traffic::Time requested_at);
+
+  QuiescenceStatus evaluate(
+    rmf_traffic::Time now,
+    const QuiescenceOptions& options) const;
+
+  std::uint64_t movement_revision() const;
+
+  const std::optional<Report>& latest() const;
+
+private:
+  static bool _starts_match(
+    const rmf_traffic::agv::Plan::StartSet& a,
+    const rmf_traffic::agv::Plan::StartSet& b,
+    double translation_tolerance = 1e-6,
+    double rotation_tolerance = 1e-6);
+
+  std::optional<Report> _latest;
+  std::optional<rmf_traffic::Time> _stop_requested_at;
+  std::optional<rmf_traffic::Time> _stable_since;
+  std::uint64_t _movement_revision = 0;
+  bool _last_update_moved = false;
+  bool _motion_evidence = false;
+  double _translation_tolerance;
+  double _rotation_tolerance;
+};
+
+} // namespace local_traffic
+} // namespace rmf_fleet_adapter
+
+#endif // RMF_FLEET_ADAPTER__LOCAL_TRAFFIC__ROBOTOBSERVATION_HPP
diff --git a/rmf_fleet_adapter/test/local_traffic/test_RobotObservation.cpp b/rmf_fleet_adapter/test/local_traffic/test_RobotObservation.cpp
new file mode 100644
index 0000000..c03326a
--- /dev/null
+++ b/rmf_fleet_adapter/test/local_traffic/test_RobotObservation.cpp
@@ -0,0 +1,158 @@
+/*
+ * Copyright (C) 2026 Open Source Robotics Foundation
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ */
+
+#include <local_traffic/RobotObservation.hpp>
+
+#include <catch2/catch_test_macros.hpp>
+
+using namespace std::chrono_literals;
+using rmf_fleet_adapter::local_traffic::QuiescenceOptions;
+using rmf_fleet_adapter::local_traffic::QuiescenceStatus;
+using rmf_fleet_adapter::local_traffic::RobotObservationTracker;
+
+namespace {
+
+rmf_traffic::Time time_at(const std::chrono::milliseconds offset)
+{
+  return rmf_traffic::Time(rmf_traffic::Duration(offset));
+}
+
+RobotObservationTracker::Report report(
+  const std::chrono::milliseconds at,
+  const Eigen::Vector3d pose = Eigen::Vector3d::Zero(),
+  std::optional<bool> driving = std::nullopt,
+  std::optional<double> speed = std::nullopt)
+{
+  return {
+    time_at(at),
+    time_at(at),
+    pose,
+    std::move(driving),
+    std::move(speed),
+    true,
+    {rmf_traffic::agv::Plan::Start(time_at(at), 0, pose[2], pose.head<2>())}
+  };
+}
+
+QuiescenceOptions options()
+{
+  QuiescenceOptions result;
+  result.report_freshness = 400ms;
+  result.settle_duration = 300ms;
+  result.stop_timeout = 2s;
+  result.translation_tolerance = 0.02;
+  result.rotation_tolerance = 0.03;
+  result.speed_threshold = 0.01;
+  return result;
+}
+
+} // anonymous namespace
+
+TEST_CASE("Identical fresh reports settle without a movement revision")
+{
+  RobotObservationTracker tracker;
+  tracker.update(report(0ms));
+  const auto initial_revision = tracker.movement_revision();
+  tracker.request_stop(time_at(50ms));
+
+  tracker.update(report(100ms));
+  CHECK(tracker.evaluate(time_at(100ms), options())
+    == QuiescenceStatus::settling);
+
+  tracker.update(report(450ms));
+  CHECK(tracker.movement_revision() == initial_revision);
+  CHECK(tracker.evaluate(time_at(450ms), options())
+    == QuiescenceStatus::ready);
+}
+
+TEST_CASE("Material motion changes the semantic revision and restarts settling")
+{
+  RobotObservationTracker tracker;
+  tracker.request_stop(time_at(0ms));
+  tracker.update(report(100ms));
+  const auto before_move = tracker.movement_revision();
+
+  tracker.update(report(250ms, Eigen::Vector3d{0.10, 0.0, 0.0}));
+  CHECK(tracker.movement_revision() == before_move + 1);
+  CHECK(tracker.evaluate(time_at(250ms), options())
+    == QuiescenceStatus::moving);
+
+  tracker.update(report(300ms, Eigen::Vector3d{0.10, 0.0, 0.0}));
+  CHECK(tracker.evaluate(time_at(300ms), options())
+    == QuiescenceStatus::settling);
+}
+
+TEST_CASE("Pose jitter inside configured tolerances is not semantic movement")
+{
+  RobotObservationTracker tracker(0.02, 0.03);
+  tracker.update(report(0ms));
+  const auto initial_revision = tracker.movement_revision();
+  tracker.request_stop(time_at(50ms));
+
+  tracker.update(report(100ms, Eigen::Vector3d{0.01, 0.0, 0.02}));
+  tracker.update(report(450ms, Eigen::Vector3d{0.01, 0.0, 0.02}));
+  CHECK(tracker.movement_revision() == initial_revision);
+  CHECK(tracker.evaluate(time_at(450ms), options())
+    == QuiescenceStatus::ready);
+}
+
+TEST_CASE("Freshness, connectivity, valid starts, and timeout gate readiness")
+{
+  RobotObservationTracker tracker;
+  tracker.request_stop(time_at(0ms));
+  CHECK(tracker.evaluate(time_at(100ms), options())
+    == QuiescenceStatus::waiting_for_report);
+
+  auto disconnected = report(100ms);
+  disconnected.connected = false;
+  tracker.update(disconnected);
+  CHECK(tracker.evaluate(time_at(100ms), options())
+    == QuiescenceStatus::disconnected);
+
+  auto invalid = report(200ms);
+  invalid.starts.clear();
+  tracker.update(invalid);
+  CHECK(tracker.evaluate(time_at(200ms), options())
+    == QuiescenceStatus::invalid_starts);
+
+  tracker.update(report(300ms));
+  CHECK(tracker.evaluate(time_at(800ms), options())
+    == QuiescenceStatus::stale_report);
+  CHECK(tracker.evaluate(time_at(2100ms), options())
+    == QuiescenceStatus::timeout);
+}
+
+TEST_CASE("Stop acknowledgement alone is not stationary motion evidence")
+{
+  RobotObservationTracker tracker;
+  tracker.update(report(0ms, Eigen::Vector3d::Zero(), false));
+  tracker.request_stop(time_at(50ms));
+
+  tracker.update(report(100ms, Eigen::Vector3d::Zero(), false));
+  CHECK(tracker.evaluate(time_at(100ms), options())
+    == QuiescenceStatus::settling);
+
+  tracker.update(report(450ms, Eigen::Vector3d::Zero(), true));
+  CHECK(tracker.evaluate(time_at(450ms), options())
+    == QuiescenceStatus::moving);
+
+  tracker.update(report(500ms, Eigen::Vector3d::Zero(), false, 0.2));
+  CHECK(tracker.evaluate(time_at(500ms), options())
+    == QuiescenceStatus::moving);
+}
+
+TEST_CASE("A report predating the stop request cannot establish quiescence")
+{
+  RobotObservationTracker tracker;
+  tracker.update(report(100ms));
+  tracker.request_stop(time_at(150ms));
+  CHECK(tracker.evaluate(time_at(200ms), options())
+    == QuiescenceStatus::waiting_for_post_stop_report);
+}
