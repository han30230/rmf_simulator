+#include "RobotObservation.hpp"
+
+#include <cmath>
+
+namespace rmf_fleet_adapter {
+namespace local_traffic {
+
+namespace {
+
+double yaw_difference(const double a, const double b)
+{
+  return std::abs(std::remainder(a - b, 2.0*M_PI));
+}
+
+bool poses_match(
+  const Eigen::Vector3d& a,
+  const Eigen::Vector3d& b,
+  const double translation_tolerance,
+  const double rotation_tolerance)
+{
+  return (a.head<2>() - b.head<2>()).norm() <= translation_tolerance
+    && yaw_difference(a[2], b[2]) <= rotation_tolerance;
+}
+
+} // anonymous namespace
+
+RobotObservationTracker::RobotObservationTracker(
+  const double translation_tolerance,
+  const double rotation_tolerance)
+: _translation_tolerance(translation_tolerance),
+  _rotation_tolerance(rotation_tolerance)
+{
+  // Do nothing
+}
+
+void RobotObservationTracker::update(Report report)
+{
+  bool moved = false;
+  if (_latest.has_value())
+  {
+    moved = !poses_match(
+      _latest->pose,
+      report.pose,
+      _translation_tolerance,
+      _rotation_tolerance)
+      || !_starts_match(
+      _latest->starts,
+      report.starts,
+      _translation_tolerance,
+      _rotation_tolerance);
+    _motion_evidence = true;
+  }
+
+  if (report.driving.value_or(false))
+    moved = true;
+
+  if (report.speed.has_value() && std::abs(*report.speed) > 0.0)
+    _motion_evidence = true;
+
+  if (moved)
+  {
+    ++_movement_revision;
+    _stable_since = std::nullopt;
+  }
+  else if (_stop_requested_at.has_value()
+    && report.received_at > *_stop_requested_at
+    && !_stable_since.has_value())
+  {
+    _stable_since = report.sample_time;
+  }
+
+  _last_update_moved = moved;
+  _latest = std::move(report);
+}
+
+void RobotObservationTracker::request_stop(const rmf_traffic::Time requested_at)
+{
+  _stop_requested_at = requested_at;
+  _stable_since = std::nullopt;
+  _last_update_moved = false;
+  _motion_evidence = false;
+}
+
+QuiescenceStatus RobotObservationTracker::evaluate(
+  const rmf_traffic::Time now,
+  const QuiescenceOptions& options) const
+{
+  if (!_stop_requested_at.has_value())
+    return QuiescenceStatus::waiting_for_report;
+
+  if (now - *_stop_requested_at > options.stop_timeout)
+    return QuiescenceStatus::timeout;
+
+  if (!_latest.has_value())
+    return QuiescenceStatus::waiting_for_report;
+
+  if (!_latest->connected)
+    return QuiescenceStatus::disconnected;
+
+  if (_latest->received_at <= *_stop_requested_at)
+    return QuiescenceStatus::waiting_for_post_stop_report;
+
+  if (now - _latest->received_at > options.report_freshness)
+    return QuiescenceStatus::stale_report;
+
+  if (_latest->starts.empty())
+    return QuiescenceStatus::invalid_starts;
+
+  if (_latest->driving.value_or(false)
+    || (_latest->speed.has_value()
+    && std::abs(*_latest->speed) > options.speed_threshold)
+    || _last_update_moved)
+  {
+    return QuiescenceStatus::moving;
+  }
+
+  if (!_motion_evidence)
+    return QuiescenceStatus::waiting_for_motion_evidence;
+
+  if (!_stable_since.has_value()
+    || now - *_stable_since < options.settle_duration)
+  {
+    return QuiescenceStatus::settling;
+  }
+
+  return QuiescenceStatus::ready;
+}
+
+std::uint64_t RobotObservationTracker::movement_revision() const
+{
+  return _movement_revision;
+}
+
+const std::optional<RobotObservationTracker::Report>&
+RobotObservationTracker::latest() const
+{
+  return _latest;
+}
+
+bool RobotObservationTracker::_starts_match(
+  const rmf_traffic::agv::Plan::StartSet& a,
+  const rmf_traffic::agv::Plan::StartSet& b,
+  const double translation_tolerance,
+  const double rotation_tolerance)
+{
+  if (a.size() != b.size())
+    return false;
+
+  for (std::size_t i = 0; i < a.size(); ++i)
+  {
+    const auto& lhs = a[i];
+    const auto& rhs = b[i];
+    if (lhs.waypoint() != rhs.waypoint()
+      || lhs.lane() != rhs.lane()
+      || yaw_difference(lhs.orientation(), rhs.orientation())
+      > rotation_tolerance
+      || lhs.location().has_value() != rhs.location().has_value())
+    {
+      return false;
+    }
+
+    if (lhs.location().has_value()
+      && (*lhs.location() - *rhs.location()).norm() > translation_tolerance)
+    {
+      return false;
+    }
+  }
+
+  return true;
+}
+
+} // namespace local_traffic
+} // namespace rmf_fleet_adapter
