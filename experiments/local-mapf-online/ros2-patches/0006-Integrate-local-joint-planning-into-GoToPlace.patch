+//==============================================================================
+bool GoToPlace::Active::_register_local_intent()
+{
+  const auto coordinator = _context->local_joint_planning();
+  if (!coordinator || !coordinator->options().enabled
+    || !_chosen_goal.has_value())
+  {
+    return false;
+  }
+
+  coordinator->upsert_intent({
+      _context->itinerary().id(),
+      _context->location(),
+      *_chosen_goal,
+      _context->planner(),
+      _local_generation,
+      _context->local_movement_revision(),
+      _context->last_location_report_time(),
+      false,
+      [w = weak_from_this()]()
+      {
+        if (const auto self = w.lock())
+        {
+          if (self->_find_path_service)
+            self->_find_path_service->interrupt();
+          self->_context->request_local_stop();
+        }
+      },
+      [w = weak_from_this()]()
+      {
+        if (const auto self = w.lock())
+          return self->_context->local_quiescence_status();
+
+        return local_traffic::QuiescenceStatus::disconnected;
+      },
+      [w = weak_from_this(), generation = _local_generation](
+        const rmf_traffic::agv::Plan& plan)
+      {
+        const auto self = w.lock();
+        if (!self || generation != self->_local_generation
+          || !self->_chosen_goal.has_value())
+        {
+          return false;
+        }
+
+        auto itinerary = project_itinerary(
+          plan,
+          self->_description.expected_next_destinations(),
+          *self->_context->planner());
+        const auto plan_id = self->_context->itinerary().assign_plan_id();
+        if (!self->_context->itinerary().set(plan_id, itinerary))
+          return false;
+
+        self->_pending_local_plan = plan;
+        self->_pending_local_itinerary = std::move(itinerary);
+        self->_pending_local_plan_id = plan_id;
+        return true;
+      },
+      [w = weak_from_this(), generation = _local_generation]()
+      {
+        const auto self = w.lock();
+        if (!self || generation != self->_local_generation
+          || !self->_chosen_goal.has_value()
+          || !self->_pending_local_plan.has_value()
+          || !self->_pending_local_itinerary.has_value()
+          || !self->_pending_local_plan_id.has_value())
+        {
+          return false;
+        }
+
+        self->_execute_plan(
+          *self->_pending_local_plan_id,
+          std::move(*self->_pending_local_plan),
+          std::move(*self->_pending_local_itinerary),
+          *self->_chosen_goal,
+          ExecutePlan::SchedulePolicy::already_registered);
+        self->_pending_local_plan = std::nullopt;
+        self->_pending_local_itinerary = std::nullopt;
+        self->_pending_local_plan_id = std::nullopt;
+        return self->_execution.has_value();
+      },
+      [w = weak_from_this()]()
+      {
+        if (const auto self = w.lock())
+          return self->_context->restore_local_stationary_occupancy();
+
+        return false;
+      },
+      [w = weak_from_this()]()
+      {
+        if (const auto self = w.lock())
+        {
+          self->_skip_local_once = true;
+          self->_find_plan();
+        }
+      }});
+
+  if (_skip_local_once)
+  {
+    _skip_local_once = false;
+    return false;
+  }
+
+  _try_local_planning();
+  return coordinator->owner(_context->itinerary().id())
+    != local_traffic::LocalJointPlanningCoordinator::Owner::ordinary;
+}
+
+//==============================================================================
+void GoToPlace::Active::_try_local_planning()
+{
+  const auto coordinator = _context->local_joint_planning();
+  if (!coordinator)
+    return;
+
+  const auto cycle = coordinator->begin_local_cycle();
+  if (!cycle.has_value())
+    return;
+
+  auto intents = coordinator->active_intents();
+  for (const auto& intent : intents)
+  {
+    if (!intent.request_stop || !intent.quiescence_status
+      || !intent.register_plan || !intent.start_plan
+      || !intent.restore_stationary_occupancy || !intent.fallback)
+    {
+      coordinator->finish_local_cycle(*cycle);
+      return;
+    }
+
+    intent.request_stop();
+  }
+
+  _local_quiescence_timer = _context->node()->try_create_wall_timer(
+    std::chrono::milliseconds(100),
+    [w = weak_from_this(), coordinator, cycle = *cycle]()
+    {
+      const auto self = w.lock();
+      if (!self)
+        return;
+
+      self->_context->worker().schedule(
+        [w, coordinator, cycle](const auto&)
+        {
+      const auto self = w.lock();
+      if (!self)
+        return;
+
+      if (!coordinator->cycle_active(cycle))
+      {
+        self->_local_quiescence_timer = nullptr;
+        return;
+      }
+
+      auto current = coordinator->active_intents();
+      bool ready = true;
+      for (const auto& intent : current)
+      {
+        const auto status = intent.quiescence_status();
+        if (status == local_traffic::QuiescenceStatus::timeout
+          || status == local_traffic::QuiescenceStatus::stale_report
+          || status == local_traffic::QuiescenceStatus::disconnected
+          || status == local_traffic::QuiescenceStatus::invalid_starts)
+        {
+          self->_local_quiescence_timer = nullptr;
+          self->_fallback_local_group(cycle, false);
+          return;
+        }
+
+        ready = ready && status == local_traffic::QuiescenceStatus::ready;
+      }
+
+      if (!ready)
+        return;
+
+      for (const auto& intent : current)
+      {
+        if (!intent.restore_stationary_occupancy())
+        {
+          self->_local_quiescence_timer = nullptr;
+          self->_fallback_local_group(cycle, false);
+          return;
+        }
+      }
+
+      self->_local_quiescence_timer = nullptr;
+      coordinator->mark_solving(cycle);
+      const auto solve_start = self->_context->now();
+      for (auto& intent : current)
+      {
+        for (auto& start : intent.starts)
+          start.time(solve_start);
+      }
+
+      const auto viewer = self->_context->schedule()->snapshot();
+      const auto worker = self->_context->worker();
+      std::thread(
+        [w, coordinator, cycle, current = std::move(current), viewer, worker]()
+        mutable
+        {
+          auto decision = coordinator->solve(viewer, current);
+          worker.schedule(
+            [w, coordinator, cycle, current = std::move(current),
+            decision = std::move(decision)](const auto&) mutable
+            {
+              const auto self = w.lock();
+              if (!self || !coordinator->cycle_active(cycle))
+                return;
+
+              const auto validation = coordinator->validate(
+                current, coordinator->active_intents(), self->_context->now());
+              if (!validation.valid || !decision.proposal.has_value())
+              {
+                self->_fallback_local_group(cycle, false);
+                return;
+              }
+
+              const auto conflict_validation = coordinator->validate_proposal(
+                self->_context->schedule()->snapshot(),
+                current,
+                *decision.proposal);
+              if (!conflict_validation.valid)
+              {
+                self->_fallback_local_group(cycle, false);
+                return;
+              }
+
+              const auto stale_before =
+                self->_context->now() - std::chrono::seconds(1);
+              bool starts_in_past = false;
+              for (const auto& [id, plan] : *decision.proposal)
+              {
+                (void)id;
+                for (const auto& route : plan.get_itinerary())
+                {
+                  if (route.trajectory().start_time()
+                    && *route.trajectory().start_time() < stale_before)
+                  {
+                    starts_in_past = true;
+                    break;
+                  }
+                }
+              }
+
+              if (starts_in_past && self->_local_stale_retries++ == 0)
+              {
+                coordinator->finish_local_cycle(cycle);
+                self->_try_local_planning();
+                return;
+              }
+
+              if (starts_in_past)
+              {
+                self->_fallback_local_group(cycle, false);
+                return;
+              }
+
+              coordinator->mark_applying(cycle);
+              const auto intents = coordinator->active_intents();
+              std::unordered_map<rmf_traffic::ParticipantId,
+                local_traffic::LocalJointPlanningCoordinator::Intent> by_id;
