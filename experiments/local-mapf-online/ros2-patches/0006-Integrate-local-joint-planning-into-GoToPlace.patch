+
+//==============================================================================
+std::uint64_t RobotContext::local_movement_revision() const
+{
+  return _local_observation->movement_revision();
+}
+
+//==============================================================================
+rmf_traffic::Time RobotContext::last_location_report_time() const
+{
+  const auto& latest = _local_observation->latest();
+  return latest.has_value() ? latest->received_at : now();
+}
+
+//==============================================================================
+void RobotContext::request_local_stop()
+{
+  _local_observation->request_stop(now());
+  if (const auto handle = command())
+    handle->stop();
+}
+
+//==============================================================================
+void RobotContext::request_local_stop_and_hold()
+{
+  request_local_stop();
+  _local_hold_timer = node()->try_create_wall_timer(
+    std::chrono::milliseconds(100),
+    [w = weak_from_this()]()
+    {
+      const auto self = w.lock();
+      if (!self)
+        return;
+
+      self->worker().schedule(
+        [w](const auto&)
+        {
+          const auto self = w.lock();
+          if (!self)
+            return;
+
+          const auto status = self->local_quiescence_status();
+          if (status == local_traffic::QuiescenceStatus::ready)
+          {
+            self->restore_local_stationary_occupancy();
+            self->_local_hold_timer = nullptr;
+            return;
+          }
+
+          if (status == local_traffic::QuiescenceStatus::timeout
+            || status == local_traffic::QuiescenceStatus::stale_report
+            || status == local_traffic::QuiescenceStatus::disconnected)
+          {
+            // Keep the previous schedule rather than erasing physical
+            // occupancy when stopping cannot be confirmed.
+            self->_local_hold_timer = nullptr;
+          }
+        });
+    });
+}
+
+//==============================================================================
+local_traffic::QuiescenceStatus RobotContext::local_quiescence_status() const
+{
+  local_traffic::QuiescenceOptions options;
+  if (_local_joint_planning)
+  {
+    options.report_freshness = _local_joint_planning->options().report_freshness;
+    options.settle_duration = _local_joint_planning->options().settle_duration;
+    options.stop_timeout = _local_joint_planning->options().stop_timeout;
+  }
+
+  return _local_observation->evaluate(now(), options);
+}
+
+//==============================================================================
+bool RobotContext::restore_local_stationary_occupancy()
+{
+  const auto start = now();
+  const auto hold_duration = _local_joint_planning
+    ? _local_joint_planning->options().stationary_hold_duration
+    : std::chrono::hours(1);
+  const auto finish = start + hold_duration;
+  auto hold = local_traffic::make_stationary_itinerary(
+    map(), position(), start, finish);
+  const auto plan_id = itinerary().assign_plan_id();
+  return itinerary().set(plan_id, hold);
 }
 
