+LocalJointPlanningCoordinator::Validation
+LocalJointPlanningCoordinator::validate_proposal(
+  std::shared_ptr<const rmf_traffic::schedule::Viewer> viewer,
+  const std::vector<Intent>& intents,
+  const rmf_traffic::agv::LocalConflictResolver::Proposal& proposal) const
+{
+  if (!viewer)
+    return {false, "missing_schedule_snapshot"};
+
+  std::unordered_map<rmf_traffic::ParticipantId, const Intent*> by_id;
+  std::vector<rmf_traffic::ParticipantId> local_ids;
+  for (const auto& intent : intents)
+  {
+    by_id[intent.participant] = &intent;
+    local_ids.push_back(intent.participant);
+  }
+
+  if (proposal.size() != intents.size())
+    return {false, "incomplete_proposal"};
+
+  const auto conflicts = [](
+    const rmf_traffic::Profile& profile_a,
+    const rmf_traffic::schedule::Itinerary& itinerary_a,
+    const rmf_traffic::Profile& profile_b,
+    const rmf_traffic::schedule::Itinerary& itinerary_b)
+    {
+      for (const auto& route_a : itinerary_a)
+      {
+        for (const auto& route_b : itinerary_b)
+        {
+          if (route_a.map() != route_b.map())
+            continue;
+
+          if (rmf_traffic::DetectConflict::between(
+              profile_a, route_a.trajectory(), nullptr,
+              profile_b, route_b.trajectory(), nullptr).has_value())
+          {
+            return true;
+          }
+        }
+      }
+      return false;
+    };
+
+  for (auto a = proposal.begin(); a != proposal.end(); ++a)
+  {
+    const auto a_intent = by_id.find(a->first);
+    if (a_intent == by_id.end() || !a_intent->second->planner)
+      return {false, "proposal_has_unknown_participant"};
+
+    const auto& a_profile = a_intent->second->planner->get_configuration()
+      .vehicle_traits().profile();
+    auto b = a;
+    for (++b; b != proposal.end(); ++b)
+    {
+      const auto b_intent = by_id.find(b->first);
+      if (b_intent == by_id.end() || !b_intent->second->planner)
+        return {false, "proposal_has_unknown_participant"};
+
+      const auto& b_profile = b_intent->second->planner->get_configuration()
+        .vehicle_traits().profile();
+      if (conflicts(
+          a_profile, a->second.get_itinerary(),
+          b_profile, b->second.get_itinerary()))
+      {
+        return {false, "proposal_internal_conflict"};
+      }
+    }
+  }
+
+  auto query = rmf_traffic::schedule::query_all();
+  query.participants().exclude(std::move(local_ids));
+  const auto external = viewer->query(query);
+  for (const auto& [id, plan] : proposal)
+  {
+    const auto intent = by_id.find(id);
+    const auto& local_profile = intent->second->planner->get_configuration()
+      .vehicle_traits().profile();
+    for (const auto& element : external)
+    {
+      if (conflicts(
+          local_profile, plan.get_itinerary(),
+          element.description.profile(), {*element.route}))
+      {
+        return {false, "new_external_conflict"};
+      }
+    }
+  }
+
+  return {true, "valid"};
+}
