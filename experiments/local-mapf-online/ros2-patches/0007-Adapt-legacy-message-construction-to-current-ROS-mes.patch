From c4bc01c918d6c52a280e25195ec4aa0648331447 Mon Sep 17 00:00:00 2001
From: han30230 <han30230@users.noreply.github.com>
Date: Sat, 3 Oct 2026 23:18:40 +0900
Subject: [PATCH 7/9] Adapt legacy message construction to current ROS messages

---
 .../src/rmf_fleet_adapter/TaskManager.cpp     | 10 ++--
 .../agv/EasyTrafficLight.cpp                  | 54 +++++++------------
 .../agv/test/MockAdapter.cpp                  |  8 +--
 3 files changed, 28 insertions(+), 44 deletions(-)

diff --git a/rmf_fleet_adapter/src/rmf_fleet_adapter/TaskManager.cpp b/rmf_fleet_adapter/src/rmf_fleet_adapter/TaskManager.cpp
index 38cca49..92d0d71 100644
--- a/rmf_fleet_adapter/src/rmf_fleet_adapter/TaskManager.cpp
+++ b/rmf_fleet_adapter/src/rmf_fleet_adapter/TaskManager.cpp
@@ -1073,11 +1073,11 @@ void TaskManager::reassign_dispatched_requests(
 //==============================================================================
 TaskManager::RobotModeMsg TaskManager::robot_mode() const
 {
-  const auto mode = rmf_fleet_msgs::build<RobotModeMsg>()
-    .mode(_active_task.is_finished() ?
-      RobotModeMsg::MODE_IDLE :
-      _context->current_mode())
-    .mode_request_id(0);
+  RobotModeMsg mode;
+  mode.mode = _active_task.is_finished()
+    ? RobotModeMsg::MODE_IDLE
+    : _context->current_mode();
+  mode.mode_request_id = 0;
 
   return mode;
 }
diff --git a/rmf_fleet_adapter/src/rmf_fleet_adapter/agv/EasyTrafficLight.cpp b/rmf_fleet_adapter/src/rmf_fleet_adapter/agv/EasyTrafficLight.cpp
index 90f8d9e..31f5fcc 100644
--- a/rmf_fleet_adapter/src/rmf_fleet_adapter/agv/EasyTrafficLight.cpp
+++ b/rmf_fleet_adapter/src/rmf_fleet_adapter/agv/EasyTrafficLight.cpp
@@ -1039,23 +1039,13 @@ void EasyTrafficLight::Implementation::Shared::publish_fleet_state() const
   if (!reported_location.has_value())
     return;
 
-  auto robot_mode = [&]()
-    {
-      if (state.range.begin == state.range.end)
-      {
-        return rmf_fleet_msgs::build<rmf_fleet_msgs::msg::RobotMode>()
-          .mode(rmf_fleet_msgs::msg::RobotMode::MODE_WAITING)
-          // NOTE(MXG): This field is currently only used by the fleet drivers.
-          // For now, we will just fill it with a zero.
-          .mode_request_id(0);
-      }
-
-      return rmf_fleet_msgs::build<rmf_fleet_msgs::msg::RobotMode>()
-        .mode(rmf_fleet_msgs::msg::RobotMode::MODE_MOVING)
-        // NOTE(MXG): This field is currently only used by the fleet drivers.
-        // For now, we will just fill it with a zero.
-        .mode_request_id(0);
-    } ();
+  rmf_fleet_msgs::msg::RobotMode robot_mode;
+  robot_mode.mode = state.range.begin == state.range.end
+    ? rmf_fleet_msgs::msg::RobotMode::MODE_WAITING
+    : rmf_fleet_msgs::msg::RobotMode::MODE_MOVING;
+  // NOTE(MXG): This field is currently only used by the fleet drivers.
+  // For now, we will just fill it with a zero.
+  robot_mode.mode_request_id = 0;
 
   const auto& map = reported_location->map;
   const auto p = reported_location->position;
@@ -1070,24 +1060,18 @@ void EasyTrafficLight::Implementation::Shared::publish_fleet_state() const
     .index(0);
 
   const auto& fleet_name = state.itinerary->description().owner();
-  auto robot_state = rmf_fleet_msgs::build<rmf_fleet_msgs::msg::RobotState>()
-    .name(state.itinerary->description().name())
-    .model(fleet_name)
-    // TODO(MXG): Have a way to fill this in
-    .task_id("")
-    // TODO(MXG): We could keep track of the seq value and increment it once
-    // with each publication. This is not currently an important feature
-    // outside of the fleet driver, so for now we just set it to zero.
-    .seq(0)
-    .mode(std::move(robot_mode))
-    // We multiply by 100 to convert from the [0.0, 1.0] range to percentage
-    .battery_percent(battery_soc*100.0)
-    .location(std::move(location))
-    .path({});
-
-  const auto& fleet_state = rmf_fleet_msgs::build<rmf_fleet_msgs::msg::FleetState>()
-    .name(fleet_name)
-    .robots({std::move(robot_state)});
+  rmf_fleet_msgs::msg::RobotState robot_state;
+  robot_state.name = state.itinerary->description().name();
+  robot_state.model = fleet_name;
+  robot_state.task_id = "";
+  robot_state.seq = 0;
+  robot_state.mode = std::move(robot_mode);
+  robot_state.battery_percent = battery_soc*100.0;
+  robot_state.location = std::move(location);
+
+  rmf_fleet_msgs::msg::FleetState fleet_state;
+  fleet_state.name = fleet_name;
+  fleet_state.robots = {std::move(robot_state)};
 
   hooks.fleet_state_pub->publish(fleet_state);
 }
diff --git a/rmf_fleet_adapter/src/rmf_fleet_adapter/agv/test/MockAdapter.cpp b/rmf_fleet_adapter/src/rmf_fleet_adapter/agv/test/MockAdapter.cpp
index 1be09fe..32ba2f8 100644
--- a/rmf_fleet_adapter/src/rmf_fleet_adapter/agv/test/MockAdapter.cpp
+++ b/rmf_fleet_adapter/src/rmf_fleet_adapter/agv/test/MockAdapter.cpp
@@ -345,10 +345,10 @@ void MockAdapter::dispatch_task(
 
         // NOTE: although the current adapter supports multiple fleets. The test
         // here assumses using a single fleet for each adapter
-        auto bid = rmf_task_msgs::build<rmf_task_msgs::msg::BidNotice>()
-        .request(request.dump())
-        .task_id(task_id)
-        .time_window(rclcpp::Duration(2, 0));
+        rmf_task_msgs::msg::BidNotice bid;
+        bid.request = request.dump();
+        bid.task_id = task_id;
+        bid.time_window = rclcpp::Duration(2, 0);
 
         fimpl.bid_notice_cb(
           bid,
-- 
2.43.0

