+TEST_CASE("Mixed registration view blocks all execution until mirror converges")
+{
+  using Stamp = GroupPlanApplication::RegistrationStamp;
+  std::vector<std::size_t> started;
+  auto a_local = std::make_shared<std::optional<Stamp>>(Stamp{1, 1});
+  auto b_local = std::make_shared<std::optional<Stamp>>(Stamp{2, 1});
+  auto a_mirror = std::make_shared<std::optional<Stamp>>(*a_local);
+  auto b_mirror = std::make_shared<std::optional<Stamp>>(*b_local);
+
+  auto make = [&](std::size_t id,
+    std::shared_ptr<std::optional<Stamp>> local,
+    std::shared_ptr<std::optional<Stamp>> mirror)
+    {
+      return GroupPlanApplication::Participant{
+        id,
+        [id, local]()
+        {
+          *local = Stamp{id + 100, 2};
+          return *local;
+        },
+        [local]() { return *local; },
+        [mirror]() { return *mirror; },
+        [&, id]() { started.push_back(id); return true; },
+        []() {},
+        []() {}};
+    };
+
+  auto participants = std::vector<GroupPlanApplication::Participant>{
+    make(1, a_local, a_mirror), make(2, b_local, b_mirror)};
+  auto registration = GroupPlanApplication::register_all(participants);
+  REQUIRE(registration.status == GroupPlanApplication::Status::success);
+
+  // Reproduce the observed schedule race: A has propagated, B is still old.
+  *a_mirror = *a_local;
+  CHECK(GroupPlanApplication::registration_state(
+      participants, registration.transitions)
+    == GroupPlanApplication::RegistrationState::waiting);
+  CHECK(started.empty());
+
+  *b_mirror = *b_local;
+  CHECK(GroupPlanApplication::registration_state(
+      participants, registration.transitions)
+    == GroupPlanApplication::RegistrationState::ready);
+  const auto result = GroupPlanApplication::start_all(
+    participants, registration.transitions, []() {});
+  CHECK(result.status == GroupPlanApplication::Status::success);
+  CHECK(started == std::vector<std::size_t>{1, 2});
+}
