 class GroupPlanApplication
 {
 public:
+  struct RegistrationStamp
+  {
+    rmf_traffic::PlanId plan_id;
+    rmf_traffic::schedule::ItineraryVersion itinerary_version;
+
+    bool operator==(const RegistrationStamp& other) const
+    {
+      return plan_id == other.plan_id
+        && itinerary_version == other.itinerary_version;
+    }
+
+    bool operator!=(const RegistrationStamp& other) const
+    {
+      return !(*this == other);
+    }
+  };
+
+  struct RegistrationTransition
+  {
+    rmf_traffic::ParticipantId participant;
+    std::optional<RegistrationStamp> previous;
+    RegistrationStamp current;
+  };
+
+  enum class RegistrationState
+  {
+    waiting,
+    ready,
+    mismatch
+  };
+
   enum class Status
   {
     success,
     registration_failed,
     execution_failed
@@
