+TEST_CASE("Only previous/current local transition negotiations are stale")
+{
+  using Coordinator = LocalJointPlanningCoordinator;
+  using Stamp = GroupPlanApplication::RegistrationStamp;
+  Coordinator::Options options;
+  options.enabled = true;
+  Coordinator coordinator(options);
+
+  auto local1 = std::make_shared<std::optional<Stamp>>(Stamp{11, 2});
+  auto local2 = std::make_shared<std::optional<Stamp>>(Stamp{12, 2});
+  auto mirror1 = std::make_shared<std::optional<Stamp>>(*local1);
+  auto mirror2 = std::make_shared<std::optional<Stamp>>(*local2);
+  auto i1 = intent(1);
+  i1.current_registration = [local1]() { return *local1; };
+  i1.mirrored_registration = [mirror1]() { return *mirror1; };
+  auto i2 = intent(2);
+  i2.current_registration = [local2]() { return *local2; };
+  i2.mirrored_registration = [mirror2]() { return *mirror2; };
+  coordinator.upsert_intent(std::move(i1));
+  coordinator.upsert_intent(std::move(i2));
+
+  const auto cycle = coordinator.begin_local_cycle();
+  REQUIRE(cycle.has_value());
+  coordinator.mark_applying(*cycle);
+  coordinator.stage_local_registration(
+    *cycle,
+    {{1, Stamp{1, 1}, *local1}, {2, Stamp{2, 1}, *local2}});
+
+  CHECK(coordinator.is_stale_local_negotiation({{1, 11}, {2, 2}}));
+  CHECK_FALSE(coordinator.is_stale_local_negotiation({{1, 11}, {2, 12}}));
+  CHECK_FALSE(coordinator.is_stale_local_negotiation({{1, 1}, {99, 8}}));
+
+  coordinator.commit_local_execution(*cycle);
+  CHECK(coordinator.owner(1) == Coordinator::Owner::local_executing);
+  CHECK(coordinator.is_stale_local_negotiation({{1, 1}, {2, 2}}));
+  CHECK_FALSE(coordinator.is_stale_local_negotiation({{1, 11}, {2, 12}}));
+}
