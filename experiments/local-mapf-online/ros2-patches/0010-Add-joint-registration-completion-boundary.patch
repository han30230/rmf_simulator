+void LocalJointPlanningCoordinator::stage_local_registration(
+  const std::uint64_t cycle,
+  std::vector<GroupPlanApplication::RegistrationTransition> transitions)
+{
+  if (!cycle_active(cycle))
+    return;
+
+  _active_registrations.clear();
+  for (auto& transition : transitions)
+  {
+    _active_registrations.insert_or_assign(
+      transition.participant, std::move(transition));
+  }
+}
+
+void LocalJointPlanningCoordinator::commit_local_execution(
+  const std::uint64_t cycle)
+{
+  if (!cycle_active(cycle))
+    return;
+
+  _committed_registrations = _active_registrations;
+  _active_registrations.clear();
+  _active_cycle = std::nullopt;
+  _active_intent_key.clear();
+  _consecutive_failures = 0;
+  _failed_intent_key.clear();
+
+  for (auto& [id, value] : _owners)
+  {
+    value = _committed_registrations.count(id) > 0
+      ? Owner::local_executing
+      : Owner::ordinary;
+  }
+}
+
+void LocalJointPlanningCoordinator::clear_local_registration(
+  const std::uint64_t cycle)
+{
+  if (!cycle_active(cycle))
+    return;
+  _active_registrations.clear();
+}
+
+bool LocalJointPlanningCoordinator::is_stale_local_negotiation(
+  const std::vector<NegotiationReference>& references) const
+{
+  const auto& registrations = !_active_registrations.empty()
+    ? _active_registrations
+    : _committed_registrations;
+
+  if (registrations.empty() || references.empty())
+    return false;
+
+  // The local writer must still be on the staged/committed current pair.
+  // During the registration barrier the mirror is intentionally allowed to be
+  // previous/current mixed; after commit the mirror must also be current.
+  const bool committed = _active_registrations.empty();
+  for (const auto& [id, transition] : registrations)
+  {
+    const auto intent = _intents.find(id);
+    if (intent == _intents.end() || !intent->second.current_registration)
+      return false;
+
+    const auto local = intent->second.current_registration();
+    if (!local.has_value() || *local != transition.current)
+      return false;
+
+    if (committed)
+    {
+      if (!intent->second.mirrored_registration)
+        return false;
+      const auto mirror = intent->second.mirrored_registration();
+      if (!mirror.has_value() || *mirror != transition.current)
+        return false;
+    }
+  }
+
+  bool saw_previous = false;
+  for (const auto& ref : references)
+  {
+    const auto it = registrations.find(ref.participant);
+    if (it == registrations.end())
+      return false; // external conflict: preserve it
+
+    if (ref.plan_id == it->second.current.plan_id)
+      continue;
+
+    if (it->second.previous.has_value()
+      && ref.plan_id == it->second.previous->plan_id)
+    {
+      saw_previous = true;
+      continue;
+    }
+
+    return false;
+  }
+
+  // current/current is a real conflict. Only a transition that still
+  // references at least one previous local plan is stale.
+  return saw_previous;
+}
