   {
     rmf_traffic::ParticipantId id;
-    std::function<bool()> register_itinerary;
+    std::function<std::optional<RegistrationStamp>()> register_itinerary;
+    std::function<std::optional<RegistrationStamp>()> current_registration;
+    std::function<std::optional<RegistrationStamp>()> mirrored_registration;
     std::function<bool()> start_execution;
     std::function<void()> request_stop;
     std::function<void()> restore_stationary_occupancy;
   };
@@
     Status status;
     std::vector<rmf_traffic::ParticipantId> registered;
     std::vector<rmf_traffic::ParticipantId> started;
+    std::vector<RegistrationTransition> transitions;
   };
 
