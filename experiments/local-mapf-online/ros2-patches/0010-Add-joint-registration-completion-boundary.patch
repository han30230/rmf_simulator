+}
+
+GroupPlanApplication::RegistrationState
+GroupPlanApplication::registration_state(
+  const std::vector<Participant>& participants,
+  const std::vector<RegistrationTransition>& transitions)
+{
+  if (participants.size() != transitions.size())
+    return RegistrationState::mismatch;
+
+  bool waiting = false;
+  for (const auto& participant : participants)
+  {
+    const auto transition = std::find_if(
+      transitions.begin(), transitions.end(),
+      [&](const auto& t) { return t.participant == participant.id; });
+    if (transition == transitions.end()
+      || !participant.current_registration
+      || !participant.mirrored_registration)
+    {
+      return RegistrationState::mismatch;
+    }
+
+    const auto local = participant.current_registration();
+    if (!local.has_value() || *local != transition->current)
+      return RegistrationState::mismatch;
+
+    const auto mirrored = participant.mirrored_registration();
+    if (!mirrored.has_value())
+    {
+      waiting = true;
+      continue;
+    }
+
+    if (*mirrored == transition->current)
+      continue;
+
+    if (transition->previous.has_value()
+      && *mirrored == *transition->previous)
+    {
+      waiting = true;
+      continue;
+    }
+
+    return RegistrationState::mismatch;
+  }
+
+  return waiting ? RegistrationState::waiting : RegistrationState::ready;
+}
+
+GroupPlanApplication::Result GroupPlanApplication::start_all(
+  const std::vector<Participant>& participants,
+  const std::vector<RegistrationTransition>& transitions,
+  std::function<void()> recover_after_quiescence)
+{
+  Result result{Status::success, {}, {}, transitions};
+  for (const auto& transition : transitions)
+    result.registered.push_back(transition.participant);
+  result.started.reserve(participants.size());
+
   for (const auto& participant : participants)
   {
     if (!participant.start_execution())
@@
   return result;
 }
