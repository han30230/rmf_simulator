+namespace rmf_fleet_adapter {
+namespace local_traffic {
+
+rmf_traffic::schedule::Itinerary make_stationary_itinerary(
+  std::string map,
+  Eigen::Vector3d pose,
+  const rmf_traffic::Time start,
+  const rmf_traffic::Time finish)
+{
+  if (finish <= start)
+    throw std::invalid_argument("Stationary occupancy must have a duration");
+
+  rmf_traffic::Trajectory trajectory;
+  trajectory.insert(start, pose, Eigen::Vector3d::Zero());
+  trajectory.insert(finish, pose, Eigen::Vector3d::Zero());
+
+  rmf_traffic::schedule::Itinerary itinerary;
+  itinerary.emplace_back(std::move(map), std::move(trajectory));
+  return itinerary;
+}
+
+GroupPlanApplication::Result GroupPlanApplication::apply(
+  const std::vector<Participant>& participants,
+  std::function<void()> recover_after_quiescence)
+{
+  Result result{Status::success, {}, {}};
+  result.registered.reserve(participants.size());
+  result.started.reserve(participants.size());
+
+  for (const auto& participant : participants)
+  {
+    if (!participant.register_itinerary())
+    {
+      result.status = Status::registration_failed;
+      for (const auto& member : participants)
+        member.restore_stationary_occupancy();
+
+      return result;
+    }
+
+    result.registered.push_back(participant.id);
+  }
+
+  for (const auto& participant : participants)
+  {
+    if (!participant.start_execution())
+    {
+      result.status = Status::execution_failed;
+      for (const auto& member : participants)
+        member.request_stop();
+
+      recover_after_quiescence();
+      return result;
+    }
+
+    result.started.push_back(participant.id);
+  }
+
+  return result;
+}
+
+} // namespace local_traffic
+} // namespace rmf_fleet_adapter
