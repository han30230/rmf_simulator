+
+#include <catch2/catch_test_macros.hpp>
+
+using namespace std::chrono_literals;
+using rmf_fleet_adapter::local_traffic::GroupPlanApplication;
+
+namespace {
+
+rmf_traffic::Time time_at(const std::chrono::seconds offset)
+{
+  return rmf_traffic::Time(rmf_traffic::Duration(offset));
+}
+
+} // anonymous namespace
+
+TEST_CASE("Stationary occupancy retains the physical pose")
+{
+  const Eigen::Vector3d pose{1.0, 2.0, 0.4};
+  const auto itinerary =
+    rmf_fleet_adapter::local_traffic::make_stationary_itinerary(
+    "test_map", pose, time_at(1s), time_at(11s));
+
+  REQUIRE(itinerary.size() == 1);
+  const auto& trajectory = itinerary.front().trajectory();
+  REQUIRE(trajectory.size() == 2);
+  CHECK(trajectory.front().time() == time_at(1s));
+  CHECK(trajectory.back().time() == time_at(11s));
+  CHECK(trajectory.front().position().isApprox(pose));
+  CHECK(trajectory.back().position().isApprox(pose));
+}
+
+TEST_CASE("Schedule registration failure starts no commands and restores holds")
+{
+  std::vector<std::size_t> registered;
+  std::vector<std::size_t> started;
+  std::vector<std::size_t> restored;
+  std::vector<std::size_t> stopped;
+  std::size_t recoveries = 0;
+
+  auto participant = [&](const std::size_t id)
+    {
+      return GroupPlanApplication::Participant{
+        id,
+        [&, id]()
+        {
+          registered.push_back(id);
+          return id != 2;
+        },
+        [&, id]()
+        {
+          started.push_back(id);
+          return true;
+        },
+        [&, id]() { stopped.push_back(id); },
+        [&, id]() { restored.push_back(id); }};
+    };
+
+  const auto result = GroupPlanApplication::apply(
+    {participant(1), participant(2), participant(3)},
+    [&]() { ++recoveries; });
+
+  CHECK(result.status == GroupPlanApplication::Status::registration_failed);
+  CHECK(registered == std::vector<std::size_t>{1, 2});
+  CHECK(started.empty());
+  CHECK(stopped.empty());
+  CHECK(restored == std::vector<std::size_t>{1, 2, 3});
+  CHECK(recoveries == 0);
+}
+
+TEST_CASE("Execution start failure stops the whole group before recovery")
+{
+  std::vector<std::size_t> registered;
+  std::vector<std::size_t> started;
+  std::vector<std::size_t> stopped;
+  std::vector<std::size_t> restored;
+  std::size_t recoveries = 0;
+
+  auto participant = [&](const std::size_t id)
+    {
+      return GroupPlanApplication::Participant{
+        id,
+        [&, id]()
+        {
+          registered.push_back(id);
+          return true;
+        },
+        [&, id]()
+        {
+          started.push_back(id);
+          return id != 2;
+        },
+        [&, id]() { stopped.push_back(id); },
+        [&, id]() { restored.push_back(id); }};
+    };
+
+  const auto result = GroupPlanApplication::apply(
+    {participant(1), participant(2), participant(3)},
+    [&]() { ++recoveries; });
+
+  CHECK(result.status == GroupPlanApplication::Status::execution_failed);
+  CHECK(registered == std::vector<std::size_t>{1, 2, 3});
+  CHECK(started == std::vector<std::size_t>{1, 2});
+  CHECK(stopped == std::vector<std::size_t>{1, 2, 3});
+  CHECK(restored.empty());
+  CHECK(recoveries == 1);
+}
+
+TEST_CASE("Successful group application registers everyone before starting")
+{
+  std::vector<std::string> calls;
+  auto participant = [&](const std::size_t id)
+    {
+      return GroupPlanApplication::Participant{
+        id,
+        [&, id]()
+        {
+          calls.push_back("register_" + std::to_string(id));
+          return true;
+        },
+        [&, id]()
+        {
+          calls.push_back("start_" + std::to_string(id));
+          return true;
+        },
+        []() {},
+        []() {}};
+    };
+
+  const auto result = GroupPlanApplication::apply(
+    {participant(1), participant(2)}, []() {});
+
+  CHECK(result.status == GroupPlanApplication::Status::success);
+  CHECK(calls == std::vector<std::string>{
+      "register_1", "register_2", "start_1", "start_2"});
+}
