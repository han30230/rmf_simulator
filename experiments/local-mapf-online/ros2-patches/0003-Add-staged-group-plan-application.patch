+#ifndef RMF_FLEET_ADAPTER__LOCAL_TRAFFIC__GROUPPLANAPPLICATION_HPP
+#define RMF_FLEET_ADAPTER__LOCAL_TRAFFIC__GROUPPLANAPPLICATION_HPP
+
+#include <rmf_traffic/schedule/Itinerary.hpp>
+
+#include <Eigen/Core>
+
+#include <functional>
+#include <vector>
+
+namespace rmf_fleet_adapter {
+namespace local_traffic {
+
+rmf_traffic::schedule::Itinerary make_stationary_itinerary(
+  std::string map,
+  Eigen::Vector3d pose,
+  rmf_traffic::Time start,
+  rmf_traffic::Time finish);
+
+/// Performs the two non-atomic application stages while robots are stopped.
+/// Physical quiescence before application and after a partial start failure is
+/// the responsibility of the owning coordinator.
+class GroupPlanApplication
+{
+public:
+  enum class Status
+  {
+    success,
+    registration_failed,
+    execution_failed
+  };
+
+  struct Participant
+  {
+    rmf_traffic::ParticipantId id;
+    std::function<bool()> register_itinerary;
+    std::function<bool()> start_execution;
+    std::function<void()> request_stop;
+    std::function<void()> restore_stationary_occupancy;
+  };
+
+  struct Result
+  {
+    Status status;
+    std::vector<rmf_traffic::ParticipantId> registered;
+    std::vector<rmf_traffic::ParticipantId> started;
+  };
+
+  static Result apply(
+    const std::vector<Participant>& participants,
+    std::function<void()> recover_after_quiescence);
+};
+
+} // namespace local_traffic
+} // namespace rmf_fleet_adapter
+
+#endif // RMF_FLEET_ADAPTER__LOCAL_TRAFFIC__GROUPPLANAPPLICATION_HPP
