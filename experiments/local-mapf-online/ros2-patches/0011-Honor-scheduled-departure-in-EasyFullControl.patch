+                context->worker().schedule(
+                  [context, data, identifier, finisher](const auto&)
+                  {
+                    if (!ActivityIdentifier::Implementation::get(
+                        *identifier).update_fn)
+                    {
+                      data->finish_timer = nullptr;
+                      return;
+                    }
+
+                    if (data->earliest_finish.has_value()
+                      && context->now() < *data->earliest_finish)
+                    {
+                      return;
+                    }
+
+                    data->finish_timer = nullptr;
+                    ActivityIdentifier::Implementation::get(
+                      *identifier).update_fn = nullptr;
+                    if (data->schedule_override.has_value())
+                    {
+                      data->release_stubbornness();
+                      RCLCPP_INFO(
+                        context->node()->get_logger(),
+                        "Requesting replan for [%s] after finishing a "
+                        "schedule override",
+                        context->requester_id().c_str());
+                      context->request_replan();
+                    }
+                    else
+                    {
+                      finisher();
+                    }
+                  });
+              });
+          }
+          return;
+        }
+
         // Prevent this activity from doing any further updates
         ActivityIdentifier::Implementation::get(
           *identifier).update_fn = nullptr;
