+/*
+ * Copyright (C) 2026 Open Source Robotics Foundation
+ * Licensed under the Apache License, Version 2.0
+ */
+
+#include <local_traffic/LocalJointPlanningCoordinator.hpp>
+
+#include <catch2/catch_test_macros.hpp>
+
+using namespace std::chrono_literals;
+using rmf_fleet_adapter::local_traffic::LocalJointPlanningCoordinator;
+
+namespace {
+
+LocalJointPlanningCoordinator::Intent intent(
+  const rmf_traffic::ParticipantId id,
+  const std::uint64_t generation = 1,
+  const std::uint64_t movement_revision = 1)
+{
+  const auto now = rmf_traffic::Time(rmf_traffic::Duration(1s));
+  return {
+    id,
+    {rmf_traffic::agv::Plan::Start(now, id, 0.0)},
+    rmf_traffic::agv::Plan::Goal(id + 10),
+    nullptr,
+    generation,
+    movement_revision,
+    now,
+    false};
+}
+
+} // anonymous namespace
+
+TEST_CASE("Local joint planning is disabled by default")
+{
+  const auto options = LocalJointPlanningCoordinator::Options::load({});
+  CHECK_FALSE(options.enabled);
+  CHECK(options.max_agents == 4);
+}
+
+TEST_CASE("Configured maximum cannot exceed the core hard limit")
+{
+  const auto options = LocalJointPlanningCoordinator::Options::load(
+    {{"RMF_LOCAL_MAPF_ENABLED", "1"}, {"RMF_LOCAL_MAPF_MAX_AGENTS", "99"}});
+  CHECK(options.enabled);
+  CHECK(options.max_agents == 4);
+}
+
+TEST_CASE("More than four active intents safely returns legacy ownership")
+{
+  LocalJointPlanningCoordinator::Options options;
+  options.enabled = true;
+  LocalJointPlanningCoordinator coordinator(options);
+  const auto decision = coordinator.solve(
+    nullptr, {intent(1), intent(2), intent(3), intent(4), intent(5)});
+
+  CHECK(decision.status
+    == LocalJointPlanningCoordinator::Status::fallback_too_many_agents);
+  CHECK_FALSE(decision.proposal.has_value());
+}
+
+TEST_CASE("Unsupported intents safely return legacy ownership")
+{
+  LocalJointPlanningCoordinator::Options options;
+  options.enabled = true;
+  LocalJointPlanningCoordinator coordinator(options);
+  const auto decision = coordinator.solve(nullptr, {intent(1), intent(2)});
+
+  CHECK(decision.status
+    == LocalJointPlanningCoordinator::Status::fallback_unsupported);
+  CHECK_FALSE(decision.proposal.has_value());
+}
+
+TEST_CASE("Generation goal cancellation and material motion are strict stale checks")
+{
+  LocalJointPlanningCoordinator::Options options;
+  options.enabled = true;
+  options.report_freshness = 2s;
+  LocalJointPlanningCoordinator coordinator(options);
+  const auto captured = std::vector{intent(1), intent(2)};
+  const auto now = rmf_traffic::Time(rmf_traffic::Duration(2s));
+
+  CHECK(coordinator.validate(captured, captured, now).valid);
+
+  auto current = captured;
+  current[0].generation++;
+  CHECK(coordinator.validate(captured, current, now).reason
+    == "generation_changed");
+
+  current = captured;
+  current[0].goal.waypoint(99);
+  CHECK(coordinator.validate(captured, current, now).reason
+    == "goal_changed");
+
+  current = captured;
+  current[0].cancelled = true;
+  CHECK(coordinator.validate(captured, current, now).reason == "cancelled");
+
+  current = captured;
+  current[0].movement_revision++;
+  CHECK(coordinator.validate(captured, current, now).reason
+    == "location_changed");
+}
+
+TEST_CASE("Fresh identical telemetry does not stale a captured intent")
+{
+  LocalJointPlanningCoordinator::Options options;
+  options.enabled = true;
+  options.report_freshness = 2s;
+  LocalJointPlanningCoordinator coordinator(options);
+  const auto captured = std::vector{intent(1), intent(2)};
+  auto current = captured;
+  current[0].report_received =
+    rmf_traffic::Time(rmf_traffic::Duration(1500ms));
+  const auto now = rmf_traffic::Time(rmf_traffic::Duration(2s));
+
+  CHECK(coordinator.validate(captured, current, now).valid);
+}
+
+TEST_CASE("Stale telemetry rejects application")
+{
+  LocalJointPlanningCoordinator::Options options;
+  options.enabled = true;
+  options.report_freshness = 500ms;
+  LocalJointPlanningCoordinator coordinator(options);
+  const auto captured = std::vector{intent(1), intent(2)};
+  const auto now = rmf_traffic::Time(rmf_traffic::Duration(2s));
+
+  CHECK(coordinator.validate(captured, captured, now).reason
+    == "stale_report");
+}
