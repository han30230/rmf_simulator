+
+#include "LocalJointPlanningCoordinator.hpp"
+
+#include <algorithm>
+#include <cstdlib>
+
+namespace rmf_fleet_adapter {
+namespace local_traffic {
+
+namespace {
+
+bool truthy(const std::string& value)
+{
+  return value == "1" || value == "true" || value == "TRUE"
+    || value == "on" || value == "ON";
+}
+
+bool goals_match(
+  const rmf_traffic::agv::Plan::Goal& a,
+  const rmf_traffic::agv::Plan::Goal& b)
+{
+  if (a.waypoint() != b.waypoint()
+    || a.minimum_time() != b.minimum_time()
+    || (a.orientation() == nullptr) != (b.orientation() == nullptr))
+  {
+    return false;
+  }
+
+  return a.orientation() == nullptr || *a.orientation() == *b.orientation();
+}
+
+} // anonymous namespace
+
+LocalJointPlanningCoordinator::Options
+LocalJointPlanningCoordinator::Options::load(
+  const std::unordered_map<std::string, std::string>& environment)
+{
+  Options result;
+  const auto value = [&](const std::string& name) -> std::optional<std::string>
+    {
+      const auto it = environment.find(name);
+      if (it != environment.end())
+        return it->second;
+
+      if (!environment.empty())
+        return std::nullopt;
+
+      const auto* raw = std::getenv(name.c_str());
+      if (raw)
+        return std::string(raw);
+
+      return std::nullopt;
+    };
+
+  const auto enabled = value("RMF_LOCAL_MAPF_ENABLED");
+  if (enabled.has_value())
+    result.enabled = truthy(*enabled);
+
+  const auto parse_size = [&](const std::string& name, std::size_t& output)
+    {
+      const auto input = value(name);
+      if (!input.has_value())
+        return;
+
+      try
+      {
+        output = static_cast<std::size_t>(std::stoul(*input));
+      }
+      catch (const std::exception&)
+      {
+        // Keep the safe default.
+      }
+    };
+
+  parse_size("RMF_LOCAL_MAPF_MAX_AGENTS", result.max_agents);
+  result.max_agents = std::min(
+    result.max_agents,
+    rmf_traffic::agv::LocalConflictResolver::hard_maximum_agents);
+  parse_size(
+    "RMF_LOCAL_MAPF_MAX_HIGH_LEVEL_NODES", result.max_high_level_nodes);
+  parse_size(
+    "RMF_LOCAL_MAPF_MAX_LOW_LEVEL_REPLANS", result.max_low_level_replans);
+
+  return result;
+}
+
+LocalJointPlanningCoordinator::LocalJointPlanningCoordinator(Options options)
+: _options(std::move(options))
+{
+  _options.max_agents = std::min(
+    _options.max_agents,
+    rmf_traffic::agv::LocalConflictResolver::hard_maximum_agents);
+}
+
+LocalJointPlanningCoordinator::LocalJointPlanningCoordinator()
+: LocalJointPlanningCoordinator(Options{})
+{
+  // Do nothing
+}
+
+const LocalJointPlanningCoordinator::Options&
+LocalJointPlanningCoordinator::options() const
+{
+  return _options;
+}
+
+LocalJointPlanningCoordinator::Decision
+LocalJointPlanningCoordinator::solve(
+  std::shared_ptr<const rmf_traffic::schedule::Viewer> viewer,
+  const std::vector<Intent>& intents) const
+{
+  Decision decision;
+  decision.status = Status::fallback_disabled;
+  decision.reason = "disabled";
+
+  if (!_options.enabled)
+    return decision;
+
+  if (intents.size() < 2)
+  {
+    decision.status = Status::fallback_too_few_agents;
+    decision.reason = "too_few_agents";
+    return decision;
+  }
+
+  if (intents.size() > _options.max_agents
+    || intents.size()
+    > rmf_traffic::agv::LocalConflictResolver::hard_maximum_agents)
+  {
+    decision.status = Status::fallback_too_many_agents;
+    decision.reason = "too_many_agents";
+    return decision;
+  }
+
+  std::vector<rmf_traffic::agv::LocalConflictResolver::Agent> agents;
+  agents.reserve(intents.size());
+  for (const auto& intent : intents)
+  {
+    if (intent.cancelled || !intent.planner || intent.starts.empty())
+    {
+      decision.status = Status::fallback_unsupported;
+      decision.reason = "unsupported_intent";
+      return decision;
+    }
+
+    agents.push_back({
+      intent.participant, intent.starts, intent.goal, intent.planner});
+  }
+
+  rmf_traffic::agv::LocalConflictResolver::Options resolver_options;
+  resolver_options.max_agents = _options.max_agents;
+  resolver_options.max_high_level_nodes = _options.max_high_level_nodes;
+  resolver_options.max_low_level_replans = _options.max_low_level_replans;
+  resolver_options.max_solve_time = _options.max_solve_time;
+  resolver_options.max_low_level_time = _options.max_low_level_time;
+  const rmf_traffic::agv::LocalConflictResolver resolver(
+    std::move(viewer), resolver_options);
+  const auto result = resolver.solve(agents);
+  decision.metrics = result.metrics();
+  decision.reason = result.metrics().termination_reason;
+
+  using ResolverStatus = rmf_traffic::agv::LocalConflictResolver::Status;
+  switch (result.metrics().status)
+  {
+    case ResolverStatus::success:
+      decision.status = Status::success;
+      decision.proposal = result.proposal();
+      break;
+    case ResolverStatus::no_conflict:
+      decision.status = Status::no_conflict;
+      break;
+    case ResolverStatus::unsupported:
+      decision.status = Status::fallback_unsupported;
+      break;
+    case ResolverStatus::infeasible:
+      decision.status = Status::fallback_infeasible;
+      break;
+    case ResolverStatus::budget_exceeded:
+      decision.status = Status::fallback_budget_exceeded;
+      break;
+    case ResolverStatus::interrupted:
+      decision.status = Status::fallback_interrupted;
+      break;
+  }
+
+  return decision;
+}
+
+LocalJointPlanningCoordinator::Validation
+LocalJointPlanningCoordinator::validate(
+  const std::vector<Intent>& captured,
+  const std::vector<Intent>& current,
+  const rmf_traffic::Time now) const
+{
+  if (captured.size() != current.size())
+    return {false, "intent_set_changed"};
+
+  std::unordered_map<rmf_traffic::ParticipantId, const Intent*> by_id;
+  for (const auto& intent : current)
+    by_id[intent.participant] = &intent;
+
+  for (const auto& old : captured)
+  {
+    const auto it = by_id.find(old.participant);
+    if (it == by_id.end())
+      return {false, "intent_set_changed"};
+
+    const auto& value = *it->second;
+    if (value.cancelled)
+      return {false, "cancelled"};
+    if (value.generation != old.generation)
+      return {false, "generation_changed"};
+    if (!goals_match(value.goal, old.goal))
+      return {false, "goal_changed"};
+    if (value.movement_revision != old.movement_revision)
+      return {false, "location_changed"};
+    if (value.starts.empty())
+      return {false, "invalid_starts"};
+    if (now - value.report_received > _options.report_freshness)
+      return {false, "stale_report"};
+  }
+
+  return {true, "valid"};
+}
+
+} // namespace local_traffic
+} // namespace rmf_fleet_adapter
