+/*
+ * Copyright (C) 2026 Open Source Robotics Foundation
+ * Licensed under the Apache License, Version 2.0
+ */
+
+#ifndef RMF_FLEET_ADAPTER__LOCAL_TRAFFIC__LOCALJOINTPLANNINGCOORDINATOR_HPP
+#define RMF_FLEET_ADAPTER__LOCAL_TRAFFIC__LOCALJOINTPLANNINGCOORDINATOR_HPP
+
+#include <rmf_traffic/agv/LocalConflictResolver.hpp>
+
+#include <chrono>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <unordered_map>
+
+namespace rmf_fleet_adapter {
+namespace local_traffic {
+
+class LocalJointPlanningCoordinator
+{
+public:
+  struct Options
+  {
+    bool enabled = false;
+    std::size_t max_agents =
+      rmf_traffic::agv::LocalConflictResolver::hard_maximum_agents;
+    std::size_t max_high_level_nodes = 64;
+    std::size_t max_low_level_replans = 96;
+    std::chrono::steady_clock::duration max_solve_time =
+      std::chrono::seconds(2);
+    std::chrono::steady_clock::duration max_low_level_time =
+      std::chrono::milliseconds(500);
+    rmf_traffic::Duration report_freshness = std::chrono::seconds(1);
+
+    static Options load(
+      const std::unordered_map<std::string, std::string>& environment = {});
+  };
+
+  struct Intent
+  {
+    rmf_traffic::ParticipantId participant;
+    rmf_traffic::agv::Plan::StartSet starts;
+    rmf_traffic::agv::Plan::Goal goal;
+    std::shared_ptr<const rmf_traffic::agv::Planner> planner;
+    std::uint64_t generation;
+    std::uint64_t movement_revision;
+    rmf_traffic::Time report_received;
+    bool cancelled;
+  };
+
+  enum class Status
+  {
+    success,
+    no_conflict,
+    fallback_disabled,
+    fallback_too_few_agents,
+    fallback_too_many_agents,
+    fallback_unsupported,
+    fallback_infeasible,
+    fallback_budget_exceeded,
+    fallback_interrupted
+  };
+
+  struct Decision
+  {
+    Status status;
+    std::string reason;
+    std::optional<rmf_traffic::agv::LocalConflictResolver::Proposal> proposal;
+    rmf_traffic::agv::LocalConflictResolver::Metrics metrics;
+  };
+
+  struct Validation
+  {
+    bool valid;
+    std::string reason;
+  };
+
+  LocalJointPlanningCoordinator();
+
+  explicit LocalJointPlanningCoordinator(Options options);
+
+  const Options& options() const;
+
+  Decision solve(
+    std::shared_ptr<const rmf_traffic::schedule::Viewer> viewer,
+    const std::vector<Intent>& intents) const;
+
+  Validation validate(
+    const std::vector<Intent>& captured,
+    const std::vector<Intent>& current,
+    rmf_traffic::Time now) const;
+
+private:
+  Options _options;
+};
+
+} // namespace local_traffic
+} // namespace rmf_fleet_adapter
+
+#endif // RMF_FLEET_ADAPTER__LOCAL_TRAFFIC__LOCALJOINTPLANNINGCOORDINATOR_HPP
