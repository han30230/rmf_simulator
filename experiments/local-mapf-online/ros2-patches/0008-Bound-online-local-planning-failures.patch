+
+  // This is an opt-in integration boundary around an experimental solver. A
+  // malformed or unsupported runtime input must return ownership to the
+  // legacy negotiation path instead of terminating the fleet adapter process.
+  std::optional<rmf_traffic::agv::LocalConflictResolver::Result> result;
+  try
+  {
+    result = resolver.solve(agents);
+  }
+  catch (const std::exception& e)
