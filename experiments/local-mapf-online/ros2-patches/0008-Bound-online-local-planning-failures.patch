+void LocalJointPlanningCoordinator::complete_local_cycle(
+  const std::uint64_t cycle)
+{
+  if (!cycle_active(cycle))
+    return;
+
+  _consecutive_failures = 0;
+  finish_local_cycle(cycle);
+}
+
+void LocalJointPlanningCoordinator::fail_local_cycle(
+  const std::uint64_t cycle)
+{
+  if (!cycle_active(cycle))
+    return;
+
+  ++_consecutive_failures;
+  ++_runtime_metrics.local_failures;
+  finish_local_cycle(cycle);
+}
