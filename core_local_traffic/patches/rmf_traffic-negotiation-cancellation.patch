diff --git a/rmf_traffic/include/rmf_traffic/agv/SearchDiagnostics.hpp b/rmf_traffic/include/rmf_traffic/agv/SearchDiagnostics.hpp
new file mode 100644
--- /dev/null
+++ b/rmf_traffic/include/rmf_traffic/agv/SearchDiagnostics.hpp
@@ -0,0 +1,34 @@
+#ifndef RMF_TRAFFIC__AGV__SEARCHDIAGNOSTICS_HPP
+#define RMF_TRAFFIC__AGV__SEARCHDIAGNOSTICS_HPP
+#include <rmf_traffic/agv/Planner.hpp>
+#include <chrono>
+#include <string>
+#include <vector>
+namespace rmf_traffic { namespace agv {
+/// Optional, per-solve observer. Use only on the synchronous solve thread.
+/// Counts all calls; stores bounded samples, never changes search decisions.
+struct SearchDiagnostics
+{
+  struct Event
+  {
+    std::string phase, outcome;
+    std::size_t participant = 0, goal = 0, count = 0;
+    double elapsed_seconds = 0;
+    std::optional<double> cost_estimate, cost_limit;
+    std::vector<Eigen::Vector3d> candidate_endpoints;
+  };
+  static constexpr std::size_t event_limit = 256;
+  std::size_t tables_selected = 0, tables_skipped = 0, respond_calls = 0,
+    plan_calls = 0, rollout_calls = 0, rollout_alternatives = 0,
+    interrupted_plans = 0, saturated_plans = 0, cost_limited_plans = 0,
+    no_route_plans = 0, events_dropped = 0;
+  double respond_seconds = 0, plan_seconds = 0, rollout_seconds = 0;
+  std::vector<Event> events;
+  void record(Event event)
+  {
+    if (events.size() < event_limit) events.push_back(std::move(event));
+    else ++events_dropped;
+  }
+};
+} }
+#endif
